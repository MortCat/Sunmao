<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Sunmao.Wpf.Theme.Controls">

    <!--
        Default templates of the Sunmao controls. WPF finds them through ThemeInfo, so every control
        has a template even before SunmaoTheme is merged; colours and sizes still come from the theme
        through DynamicResource.

        The controls are lookless: apps can replace a template with their own style, and they can use
        x:Name on elements placed in content slots (Body, Actions, Action...).
    -->

    <!-- ==== IconGlyph ================================================================== -->
    <Style TargetType="{x:Type controls:IconGlyph}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:IconGlyph}">
                    <Path Data="{TemplateBinding Icon}"
                          Stroke="{TemplateBinding Foreground}"
                          StrokeThickness="{TemplateBinding Thickness}"
                          Width="{TemplateBinding Size}"
                          Height="{TemplateBinding Size}"
                          Stretch="Uniform"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==== StatusChip ================================================================= -->
    <Style TargetType="{x:Type controls:StatusChip}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:StatusChip}">
                    <Border x:Name="Pill" CornerRadius="{DynamicResource PillCorner}" Padding="10,4" Background="{DynamicResource SurfaceMutedBrush}">
                        <StackPanel Orientation="Horizontal">
                            <!-- The dot carries the state for people who cannot tell the tints apart. -->
                            <Ellipse x:Name="Dot" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                     Fill="{DynamicResource TextTertiaryBrush}" Visibility="Collapsed" />
                            <controls:IconGlyph x:Name="Glyph" Icon="{TemplateBinding Icon}" Size="13" Thickness="1.8" Margin="0,0,5,0"
                                                VerticalAlignment="Center" Foreground="{Binding Foreground, ElementName=Label}" />
                            <TextBlock x:Name="Label" Text="{TemplateBinding Text}" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowDot" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Kind" Value="Success">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SuccessBrush}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
                        </Trigger>
                        <Trigger Property="Kind" Value="Warning">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource WarningBrush}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
                        </Trigger>
                        <Trigger Property="Kind" Value="Danger">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource DangerBrush}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
                        </Trigger>
                        <Trigger Property="Kind" Value="Info">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource InfoSoftBrush}" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource InfoBrush}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource InfoTextBrush}" />
                        </Trigger>
                        <!-- Last, so it wins over the Kind tint. -->
                        <Trigger Property="ShowBackground" Value="False">
                            <Setter TargetName="Pill" Property="Padding" Value="0" />
                            <Setter TargetName="Pill" Property="Background" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==== ConnectionPill (for the chrome bar) ======================================= -->
    <Style TargetType="{x:Type controls:ConnectionPill}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ConnectionPill}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="Dot" Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource DangerBrush}" />
                        <TextBlock Text="{TemplateBinding Text}" FontSize="12.5" Margin="9,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextOnChromeBrush}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsOnline" Value="True">
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource OnlineBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==== InfoCard =================================================================== -->
    <Style TargetType="{x:Type controls:InfoCard}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:InfoCard}">
                    <Border Style="{DynamicResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid x:Name="HeaderLine">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{TemplateBinding Header}" Style="{DynamicResource SectionTitleText}" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" Content="{TemplateBinding HeaderAction}" VerticalAlignment="Center" />
                            </Grid>
                            <ContentPresenter Grid.Row="1" Content="{TemplateBinding Body}" Margin="{TemplateBinding BodyMargin}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- A card used purely as a container keeps its padding but no heading line. -->
                        <Trigger Property="Header" Value="">
                            <Setter TargetName="HeaderLine" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==== MetricTile ================================================================= -->
    <Style TargetType="{x:Type controls:MetricTile}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:MetricTile}">
                    <Border x:Name="Tile" CornerRadius="6" Padding="14,10" BorderThickness="1" MinWidth="94"
                            BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource SurfaceSoftBrush}">
                        <StackPanel>
                            <TextBlock Text="{TemplateBinding Label}" Style="{DynamicResource CaptionText}" />
                            <!-- Tabular figures: a ticking value must not shift its neighbours. -->
                            <TextBlock x:Name="ValueText" Text="{TemplateBinding Value}" FontSize="25" FontWeight="Bold" Margin="0,3,0,0"
                                       Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="CaptionLine" Text="{TemplateBinding Caption}" Margin="0,2,0,0" FontSize="11.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Caption" Value="">
                            <Setter TargetName="CaptionLine" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Accent" Value="Success">
                            <Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
                        </Trigger>
                        <Trigger Property="Accent" Value="Warning">
                            <Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
                        </Trigger>
                        <Trigger Property="Accent" Value="Danger">
                            <Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
                        </Trigger>
                        <Trigger Property="Accent" Value="Info">
                            <Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource InfoTextBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="UseAccentBackground" Value="True" />
                                <Condition Property="Accent" Value="Success" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Tile" Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                            <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="UseAccentBackground" Value="True" />
                                <Condition Property="Accent" Value="Warning" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Tile" Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                            <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="UseAccentBackground" Value="True" />
                                <Condition Property="Accent" Value="Danger" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Tile" Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                            <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="UseAccentBackground" Value="True" />
                                <Condition Property="Accent" Value="Info" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Tile" Property="Background" Value="{DynamicResource InfoSoftBrush}" />
                            <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource InfoBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==== NoticeBar ================================================================== -->
    <Style TargetType="{x:Type controls:NoticeBar}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:NoticeBar}">
                    <Border x:Name="Bar" CornerRadius="6" Padding="14,11" BorderThickness="1"
                            Background="{DynamicResource SurfaceSoftBrush}" BorderBrush="{DynamicResource LineBrush}">
                        <!-- A Grid, not a StackPanel, so the message wraps instead of being clipped. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:IconGlyph x:Name="Glyph" Icon="{DynamicResource IconInfo}" Size="17" VerticalAlignment="Top" Margin="0,1,0,0"
                                                Foreground="{Binding Foreground, ElementName=Message}" />
                            <TextBlock x:Name="Message" Grid.Column="1" Text="{TemplateBinding Text}" Margin="10,0,0,0" FontSize="12.5"
                                       LineHeight="19" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Kind" Value="Success">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                            <Setter TargetName="Bar" Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                            <Setter TargetName="Glyph" Property="Icon" Value="{DynamicResource IconCheckCircle}" />
                            <Setter TargetName="Message" Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
                        </Trigger>
                        <Trigger Property="Kind" Value="Warning">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                            <Setter TargetName="Bar" Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                            <Setter TargetName="Glyph" Property="Icon" Value="{DynamicResource IconAlert}" />
                            <Setter TargetName="Message" Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
                        </Trigger>
                        <Trigger Property="Kind" Value="Danger">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                            <Setter TargetName="Bar" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                            <Setter TargetName="Glyph" Property="Icon" Value="{DynamicResource IconErrorCircle}" />
                            <Setter TargetName="Message" Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
                        </Trigger>
                        <Trigger Property="Kind" Value="Info">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource InfoSoftBrush}" />
                            <Setter TargetName="Bar" Property="BorderBrush" Value="{DynamicResource InfoBrush}" />
                            <Setter TargetName="Message" Property="Foreground" Value="{DynamicResource InfoTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==== PageHeader ================================================================= -->
    <Style TargetType="{x:Type controls:PageHeader}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PageHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- Title and subtitle share a line: stacked, the subtitle reads as a second heading. -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Title}" Style="{DynamicResource PageTitleText}" VerticalAlignment="Center" />
                            <TextBlock Text="{TemplateBinding Subtitle}" Style="{DynamicResource PageSubtitleText}" Margin="12,0,0,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ContentPresenter Grid.Column="1" Content="{TemplateBinding Actions}" VerticalAlignment="Center" />
                        <ContentPresenter x:Name="SecondaryRow" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0" Content="{TemplateBinding Secondary}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Secondary" Value="{x:Null}">
                            <Setter TargetName="SecondaryRow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==== EmptyState ================================================================= -->
    <Style TargetType="{x:Type controls:EmptyState}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:EmptyState}">
                    <StackPanel MaxWidth="470">
                        <Border Width="66" Height="66" CornerRadius="10" Background="{DynamicResource SurfaceMutedBrush}" HorizontalAlignment="Center">
                            <controls:IconGlyph Icon="{TemplateBinding Icon}" Size="30" Thickness="1.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{TemplateBinding Title}" Style="{DynamicResource SectionTitleText}" FontSize="17" Margin="0,18,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock Text="{TemplateBinding Description}" Style="{DynamicResource PageSubtitleText}" Margin="0,9,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center" LineHeight="21" />
                        <ContentPresenter Content="{TemplateBinding Action}" Margin="0,18,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==== ListRow ==================================================================== -->
    <Style TargetType="{x:Type controls:ListRow}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ListRow}">
                    <Border x:Name="Row" CornerRadius="6" BorderThickness="1" Padding="10"
                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- The thumbnail well keeps its size with or without an image, so the list never reflows. -->
                            <Border Width="52" Height="42" CornerRadius="4" Background="{DynamicResource SurfaceMutedBrush}" ClipToBounds="True">
                                <Grid>
                                    <controls:IconGlyph Icon="{DynamicResource IconImage}" Size="18" Foreground="{DynamicResource TextTertiaryBrush}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{TemplateBinding Thumbnail}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Title}" Style="{DynamicResource RowTitleText}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{TemplateBinding Meta}" Style="{DynamicResource MetaText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="DetailLine" Text="{TemplateBinding Detail}" Margin="0,2,0,0" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <controls:StatusChip x:Name="Chip" Grid.Column="2" Text="{TemplateBinding ChipText}" Kind="{TemplateBinding ChipKind}"
                                                 VerticalAlignment="Center" />
                            <controls:IconGlyph x:Name="Chevron" Grid.Column="3" Icon="{DynamicResource IconChevronRight}" Size="17" Margin="8,0,2,0"
                                                Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
                        </Trigger>
                        <Trigger Property="Detail" Value="">
                            <Setter TargetName="DetailLine" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ChipText" Value="">
                            <Setter TargetName="Chip" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowChevron" Value="False">
                            <Setter TargetName="Chevron" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==== CheckRow =================================================================== -->
    <Style TargetType="{x:Type controls:CheckRow}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:CheckRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Neutral badge: what is being checked. The result belongs to the marker on the right. -->
                        <Border Width="38" Height="38" CornerRadius="6" Background="{DynamicResource SurfaceMutedBrush}" VerticalAlignment="Center">
                            <controls:IconGlyph Icon="{TemplateBinding Icon}" Size="18" Foreground="{DynamicResource TextSecondaryBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="13,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Title}" Style="{DynamicResource RowTitleText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="DetailLine" Text="{TemplateBinding Detail}" Margin="0,2,0,0" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <!-- Neutral shows nothing: a grey tick still reads as a tick. -->
                        <controls:IconGlyph x:Name="Marker" Grid.Column="2" Size="20" Thickness="1.7" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Detail" Value="">
                            <Setter TargetName="DetailLine" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="State" Value="Success">
                            <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Marker" Property="Icon" Value="{DynamicResource IconCheckCircle}" />
                            <Setter TargetName="Marker" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                        </Trigger>
                        <Trigger Property="State" Value="Warning">
                            <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Marker" Property="Icon" Value="{DynamicResource IconAlert}" />
                            <Setter TargetName="Marker" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                        </Trigger>
                        <Trigger Property="State" Value="Danger">
                            <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Marker" Property="Icon" Value="{DynamicResource IconErrorCircle}" />
                            <Setter TargetName="Marker" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                        </Trigger>
                        <Trigger Property="State" Value="Info">
                            <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Marker" Property="Icon" Value="{DynamicResource IconInfo}" />
                            <Setter TargetName="Marker" Property="Foreground" Value="{DynamicResource InfoBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==== DropZone =================================================================== -->
    <Style TargetType="{x:Type controls:DropZone}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:DropZone}">
                    <Grid>
                        <!-- A dashed Rectangle, not a Border (Border cannot dash): the dash says "drop here". -->
                        <Rectangle RadiusX="8" RadiusY="8" Fill="{DynamicResource SurfaceSoftBrush}" Stroke="{DynamicResource AccentSecondaryBrush}"
                                   StrokeThickness="1.6" StrokeDashArray="6 4" StrokeDashCap="Round" />
                        <Grid Margin="26">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <controls:IconGlyph Icon="{TemplateBinding Icon}" Size="76" Thickness="1.3" Foreground="{DynamicResource AccentBrush}"
                                                    HorizontalAlignment="Center" />
                                <TextBlock Text="{TemplateBinding Title}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,20,0,0" HorizontalAlignment="Center" />
                                <TextBlock Text="{TemplateBinding Description}" Style="{DynamicResource PageSubtitleText}" Margin="0,8,0,0" MaxWidth="420"
                                           TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                                <ContentPresenter Content="{TemplateBinding Action}" Margin="0,20,0,0" HorizontalAlignment="Center" />
                                <ContentPresenter Content="{TemplateBinding SecondaryAction}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                                <TextBlock x:Name="HintLine" Text="{TemplateBinding Hint}" Margin="0,16,0,0" FontSize="11.5"
                                           Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                            <controls:NoticeBar x:Name="NoteBar" Grid.Row="1" Kind="Info" Margin="0,22,0,0" Text="{TemplateBinding Note}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Hint" Value="">
                            <Setter TargetName="HintLine" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Note" Value="">
                            <Setter TargetName="NoteBar" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

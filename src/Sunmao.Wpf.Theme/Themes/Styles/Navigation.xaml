<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Two levels of navigation that must not look alike.

        ChromeTab switches between unrelated jobs on the dark application bar (icon over label).
        SegmentTab switches between views of the same job: a small raised slab in a recessed
        track (SegmentedHost). When both look the same, users cannot tell which one changed.

        Keys: ChromeBar, ChromeTab, SegmentedHost, SegmentTab, FilterTab.
    -->

    <!-- The application bar that hosts ChromeTab buttons. -->
    <Style x:Key="ChromeBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ChromeBrush}" />
        <Setter Property="Height" Value="{DynamicResource ChromeBarHeight}" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <!-- Put an IconGlyph above a TextBlock as content; bind IsChecked to the current page. -->
    <Style x:Key="ChromeTab" TargetType="ToggleButton">
        <Setter Property="Width" Value="{DynamicResource ChromeTabWidth}" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Padding" Value="0,7,0,6" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnChromeMutedBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource SunmaoFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Root" Margin="0,7" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <!-- A bar hugging the bottom edge ties the selected tab to the page below. -->
                        <Border x:Name="Underline"
                                Height="3"
                                Margin="10,0"
                                VerticalAlignment="Bottom"
                                CornerRadius="2,2,0,0"
                                Background="{DynamicResource AccentSecondaryBrush}"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ChromeHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnChromeBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ChromeSelectedBrush}" />
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnChromeSelectedBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The recessed track segments sit in. -->
    <Style x:Key="SegmentedHost" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="SegmentTab" TargetType="ToggleButton">
        <Setter Property="Height" Value="{DynamicResource SegmentHeight}" />
        <Setter Property="MinWidth" Value="92" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource SunmaoFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <!-- The hairline border marks the selected segment even without tints (high contrast). -->
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                            <Setter TargetName="Root" Property="Effect" Value="{DynamicResource SoftShadow}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A filter segment: same behaviour, sized for short labels in a list toolbar. -->
    <Style x:Key="FilterTab" TargetType="ToggleButton" BasedOn="{StaticResource SegmentTab}">
        <Setter Property="Height" Value="{DynamicResource FilterTabHeight}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

</ResourceDictionary>

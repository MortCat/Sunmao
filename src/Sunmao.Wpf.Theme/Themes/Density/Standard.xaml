<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        Standard density: mouse and keyboard at a desk. Heights start at 36 rather than the WPF
        default 23 because these applications also run beside production equipment.
        Touch.xaml defines the same keys for touch panels.
    -->

    <sys:Double x:Key="ControlHeight">36</sys:Double>
    <sys:Double x:Key="ControlFontSize">13</sys:Double>
    <Thickness x:Key="ButtonPadding">16,0</Thickness>

    <sys:Double x:Key="InputHeight">34</sys:Double>
    <Thickness x:Key="InputPadding">10,0</Thickness>

    <sys:Double x:Key="IconButtonSize">36</sys:Double>
    <sys:Double x:Key="ToggleSize">18</sys:Double>
    <sys:Double x:Key="SwitchWidth">40</sys:Double>
    <sys:Double x:Key="SwitchHeight">22</sys:Double>

    <Thickness x:Key="ListItemPadding">10,7</Thickness>
    <sys:Double x:Key="RowMinHeight">32</sys:Double>

    <sys:Double x:Key="SegmentHeight">30</sys:Double>
    <sys:Double x:Key="FilterTabHeight">26</sys:Double>
    <sys:Double x:Key="ChromeTabWidth">84</sys:Double>
    <sys:Double x:Key="ChromeBarHeight">66</sys:Double>

    <sys:Double x:Key="ScrollBarSize">11</sys:Double>

</ResourceDictionary>

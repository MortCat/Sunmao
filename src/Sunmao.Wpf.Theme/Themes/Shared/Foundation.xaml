<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Shape, typography, text styles and surfaces. Colours and sizes come from the palette and
        density dictionaries through DynamicResource, so everything here follows a theme switch.
    -->

    <!-- ==== Shape ====================================================================== -->
    <CornerRadius x:Key="CardCorner">8</CornerRadius>
    <CornerRadius x:Key="ControlCorner">6</CornerRadius>
    <CornerRadius x:Key="SmallCorner">4</CornerRadius>
    <CornerRadius x:Key="PillCorner">999</CornerRadius>

    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="PageGutter">24,20,24,20</Thickness>

    <!-- ==== Typography ================================================================= -->
    <!-- Segoe UI; WPF's composite font fallback supplies glyphs for other scripts. -->
    <FontFamily x:Key="UiFontFamily">Segoe UI</FontFamily>

    <Style x:Key="PageTitleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="PageSubtitleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="SectionTitleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="RowTitleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Tertiary colour: only for meta lines (timestamps, identifiers), never for content. -->
    <Style x:Key="MetaText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>

    <!-- ==== Surfaces =================================================================== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCorner}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <Style x:Key="Panel" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
    </Style>

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource LineBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--
        Window style for application windows: set Style="{DynamicResource AppWindow}" on the main
        window. It gives the whole tree the themed background, text colour and font.
    -->
    <Style x:Key="AppWindow" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!--
        Keyboard focus ring. WPF shows a FocusVisualStyle only for keyboard focus, so mouse users
        never see it and keyboard users always know where they are.
    -->
    <Style x:Key="SunmaoFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3"
                               RadiusX="10"
                               RadiusY="10"
                               Stroke="{DynamicResource FocusBrush}"
                               StrokeThickness="2"
                               SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

<Window x:Class="Sunmao.Wpf.Theme.Dialogs.ConfirmationDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Sunmao.Wpf.Theme.Controls"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        SizeToContent="WidthAndHeight"
        MinWidth="460"
        MaxWidth="620"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource UiFontFamily}">
    <Border Style="{DynamicResource Card}" Padding="24" Margin="8" Effect="{DynamicResource LiftShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding Title}" Style="{DynamicResource SectionTitleText}" FontSize="18" />

            <controls:NoticeBar x:Name="MessageBar" Grid.Row="1" Margin="0,18,0,0" Text="{Binding Message}" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton"
                        Content="{Binding CancelText}"
                        Style="{DynamicResource SecondaryButton}"
                        MinWidth="96"
                        IsCancel="True"
                        Click="OnCancelClicked" />
                <Button x:Name="ConfirmButton"
                        Content="{Binding ConfirmText}"
                        MinWidth="112"
                        Margin="10,0,0,0"
                        IsDefault="True"
                        Click="OnConfirmClicked" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

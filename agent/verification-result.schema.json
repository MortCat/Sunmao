{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sunmao verification result",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "profile",
    "started_at",
    "finished_at",
    "source",
    "environment",
    "status",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "enum": [
        "catalog",
        "recipes",
        "full"
      ]
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "finished_at": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "revision",
        "working_tree",
        "fingerprint"
      ],
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "working_tree": {
          "type": [
            "string",
            "null"
          ]
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "platform",
        "python",
        "step_timeout_seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "python": {
          "type": "string",
          "minLength": 1
        },
        "step_timeout_seconds": {
          "type": "integer"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "command",
          "status",
          "exit_code",
          "elapsed_seconds",
          "log",
          "diagnostic"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "error",
              "timed_out",
              "cancelled",
              "blocked"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "elapsed_seconds": {
            "type": "number"
          },
          "log": {
            "type": [
              "string",
              "null"
            ]
          },
          "diagnostic": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}

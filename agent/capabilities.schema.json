{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sunmao capability catalog",
  "type": "object",
  "required": [
    "schema_version",
    "capabilities"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "summary",
          "package",
          "api_version",
          "maturity",
          "target_frameworks",
          "contract_path",
          "source_paths",
          "recipe",
          "test",
          "verification_profile",
          "limitations"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9.-]+$"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "package": {
            "type": "string",
            "minLength": 1
          },
          "api_version": {
            "type": "string",
            "minLength": 1
          },
          "maturity": {
            "enum": [
              "example-backed"
            ],
            "type": "string"
          },
          "target_frameworks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "contract_path": {
            "type": "string",
            "minLength": 1
          },
          "source_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "recipe": {
            "type": "object",
            "required": [
              "id",
              "source",
              "readme"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "readme": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "test": {
            "type": "object",
            "required": [
              "source",
              "project",
              "class"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "project": {
                "type": "string",
                "minLength": 1
              },
              "class": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "verification_profile": {
            "type": "string",
            "enum": [
              "recipes",
              "full"
            ]
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}

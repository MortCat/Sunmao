<Application x:Class="Sunmao.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sm="clr-namespace:Sunmao.Wpf.Theme;assembly=Sunmao.Wpf.Theme">
    <Application.ShutdownMode>OnExplicitShutdown</Application.ShutdownMode>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <sm:SunmaoTheme Variant="System" Density="Standard" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
